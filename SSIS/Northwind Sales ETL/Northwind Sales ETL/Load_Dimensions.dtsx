        <SQLTask:SqlTaskData
          SQLTask:Connection="{2A80CBF0-2F73-45F8-B678-CD7DEE918CDD}"
          SQLTask:SqlStatementSource="DECLARE @StartDate DATE = '1990-01-01';&#xA;DECLARE @EndDate   DATE = '2035-12-31';&#xA;&#xA;WHILE @StartDate &lt;= @EndDate&#xA;BEGIN&#xA;    INSERT INTO dbo.Time (&#xA;        TimeID,&#xA;        FullDate,&#xA;        Day,&#xA;        Month,&#xA;        Quarter,&#xA;        Year&#xA;    )&#xA;    VALUES (&#xA;        CAST(CONVERT(VARCHAR, @StartDate, 112) AS INT), -- YYYYMMDD&#xA;        @StartDate,&#xA;        DAY(@StartDate),&#xA;        MONTH(@StartDate),&#xA;        DATEPART(QUARTER, @StartDate),&#xA;        YEAR(@StartDate)&#xA;    );&#xA;&#xA;    SET @StartDate = DATEADD(DAY, 1, @StartDate);&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
