  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>ProductSalesDS</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT TOP 10
    c.CustomerID,
    c.ContactName,
    SUM(s.SalesAmount) AS TotalSales
FROM dbo.Sales s
JOIN dbo.Customer c 
    ON s.CustomerID = c.CustomerID
GROUP BY c.CustomerID, c.ContactName
ORDER BY TotalSales DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="CustomerID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CustomerID</DataField>
        </Field>
        <Field Name="ContactName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ContactName</DataField>
        </Field>
        <Field Name="TotalSales">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TotalSales</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ProductDS">
      <Query>
        <DataSourceName>ProductsDS</DataSourceName>
        <CommandText>SELECT TOP 10
    p.ProductID,
    p.ProductName,
    SUM(s.Quantity) AS TotalQuantity,
    SUM(s.SalesAmount) AS TotalSales
FROM dbo.Sales s
JOIN dbo.Product p 
    ON s.ProductID = p.ProductID
GROUP BY p.ProductID, p.ProductName
ORDER BY TotalSales DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="ProductID">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>ProductID</DataField>
        </Field>
        <Field Name="ProductName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ProductName</DataField>
        </Field>
        <Field Name="TotalQuantity">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>TotalQuantity</DataField>
        </Field>
        <Field Name="TotalSales">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TotalSales</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="EmployeeDS">
      <Query>
        <DataSourceName>EmployeeD</DataSourceName>
        <CommandText>SELECT TOP 10
    e.EmployeeID,
    e.FirstName + ' ' + e.LastName AS EmployeeName,
    SUM(s.SalesAmount) AS TotalSales
FROM dbo.Sales s
JOIN dbo.Employee e 
    ON s.EmployeeID = e.EmployeeID
GROUP BY e.EmployeeID, e.FirstName, e.LastName
ORDER BY TotalSales DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="EmployeeID">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>EmployeeID</DataField>
        </Field>
        <Field Name="EmployeeName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>EmployeeName</DataField>
        </Field>
        <Field Name="TotalSales">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TotalSales</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TimeDS">
      <Query>
        <DataSourceName>TimeDS</DataSourceName>
        <CommandText>SELECT TOP 10
    t.Year,
    t.Month,
    SUM(s.SalesAmount) AS TotalSales
FROM dbo.Sales s
JOIN dbo.Time t 
    ON s.TimeID = t.TimeID
GROUP BY t.Year, t.Month
ORDER BY TotalSales DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="Year">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Year</DataField>
        </Field>
        <Field Name="Month">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Month</DataField>
        </Field>
        <Field Name="TotalSales">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TotalSales</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
